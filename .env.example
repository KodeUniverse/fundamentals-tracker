# Copy to .env for local use. Never commit .env.

# Database
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# EDGAR identity (SEC requires a User-Agent with contact info)
EDGAR_IDENTITY="Your Name your.email@example.com"

# Feed configuration
TICKERS=NVDA,MSFT,AAPL,GOOGL,ETN
POLL_INTERVAL_SECONDS=3600
USE_SNAPSHOT_IF_NO_NETWORK=true

# API
API_PORT=8000

# LLM configuration (required by case study; leave blank if not yet configured)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

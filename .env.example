# Copy to .env for local use. Never commit .env.

# Database
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# EDGAR identity (SEC requires a User-Agent with contact info)
EDGAR_IDENTITY="Your Name your.email@example.com"

# Feed configuration
TICKERS=NVDA,MSFT,AAPL,GOOGL,ETN
POLL_INTERVAL_SECONDS=3600

# Snapshot seeding. On startup the feed loads <SNAPSHOT_DIR>/tracker.sql.gz when the
# facts table is empty, then ingests live data on top. A populated database is never
# overwritten, so leaving this on is safe. SNAPSHOT_DIR is for local runs; Docker
# mounts ./snapshot at /app/snapshots.
SNAPSHOT_DIR=./snapshot
SEED_FROM_SNAPSHOT=true

# API
API_PORT=8000

# LLM configuration (leave blank to run without the /ask endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
